# Copy to .env and fill in. Both the strategy API and the vision pipeline
# read these from the process environment.

# ── The Blue Alliance ─────────────────────────────────────────────────────
# Free read key from https://www.thebluealliance.com/account
# Without it, every team stat returns None and the UI says so.
TBA_AUTH_KEY=

# ── Ollama (local LLM behind the strategy synthesis reads) ────────────────
# Base URL of the Ollama server. docker-compose overrides this to
# http://ollama:11434 automatically.
OLLAMA_HOST=http://localhost:11434

# Model used for the strategy / captain / coach / per-robot reads.
OLLAMA_MODEL=qwen3:8b

# ── API ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the strategy API. "*" for dev.
CORS_ORIGINS=http://localhost:5173

# SQLite path for the TBA + prediction cache.
# Volume-mounted at /data/cache.db in containers.
CACHE_DB_PATH=./scout/cache.db

# ── Vision pipeline (optional) ────────────────────────────────────────────
# Absolute path to the tesseract binary, if it is not on PATH.
# Leave unset to use whatever `tesseract` resolves to.
TESSERACT_CMD=

# ── Team scouting app (backend/) ──────────────────────────────────────────
# Placeholders only. Generate a real value with: openssl rand -hex 32
SECRET_KEY=change-me
# Alias for TBA_AUTH_KEY used by the scouting backend importer.
TBA_API_KEY=
DATABASE_URL=sqlite:///./backend/scout.db
OLLAMA_URL=http://localhost:11434
