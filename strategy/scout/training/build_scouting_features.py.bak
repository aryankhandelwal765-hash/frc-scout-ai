import pandas as pd

from predictor.config import (
    SCOUTING_DIR
)

# =========================================================
# CONFIG
# =========================================================

INPUT_FILE = (
    SCOUTING_DIR
    /
    "worlds_2026.csv"
)

OUTPUT_FILE = (
    SCOUTING_DIR
    /
    "team_scouting_features.csv"
)

# =========================================================
# LOAD
# =========================================================

print("\nLoading scouting CSV...\n")

df = pd.read_csv(
    INPUT_FILE
)

print(
    f"Loaded "
    f"{len(df)} rows.\n"
)

# =========================================================
# CLEAN
# =========================================================

# =========================================================
# CLEAN
# =========================================================

df.columns = [

    c.strip().lower()

    for c in df.columns
]

print("\nSCOUTING COLUMNS:\n")

for c in df.columns:

    print(c)

# =========================================================
# IQM HELPER
# =========================================================

def iqm(series):

    values = sorted(

        series.dropna().tolist()
    )

    if len(values) == 0:

        return 0

    if len(values) < 4:

        return sum(values) / len(values)

    lower = int(
        len(values) * 0.25
    )

    upper = int(
        len(values) * 0.75
    )

    trimmed = values[
        lower:upper
    ]

    if len(trimmed) == 0:

        return sum(values) / len(values)

    return (
        sum(trimmed)
        /
        len(trimmed)
    )

# =========================================================
# GROUP
# =========================================================

grouped = df.groupby(
    "team"
)

rows = []

# =========================================================
# BUILD FEATURES
# =========================================================

for team, group in grouped:

    matches = len(group)

    row = {

        "team":
            int(team),

        "matches":
            matches,

        "scouting_confidence":
            min(
                matches / 8,
                1.0
            ),

        "avg_auto_fuel":
            iqm(
                group.get(
                    "auto_fuel",
                    pd.Series(dtype=float)
                )
            ),

        "climb_success_rate":
            (
                group.get(
                    "climb",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "failed_climb_rate":
            (
                group.get(
                    "failed_climb",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "defense_frequency":
            (
                group.get(
                    "defense",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "trench_usage_rate":
            (
                group.get(
                    "tele_trench",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "bump_usage_rate":
            (
                group.get(
                    "tele_bump",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "passing_usage_rate":
            (
                group.get(
                    "tele_passing",
                    pd.Series(dtype=float)
                ) == 1
            ).mean(),

        "avg_hp_accuracy":
            iqm(
                group.get(
                    "hp_accuracy",
                    pd.Series(dtype=float)
                )
            ),

        "avg_driver_skill":
            iqm(
                group.get(
                    "driver_skill",
                    pd.Series(dtype=float)
                )
            ),

        "avg_reliability":
            iqm(
                group.get(
                    "reliability",
                    pd.Series(dtype=float)
                )
            )
    }

    rows.append(row)

# =========================================================
# SAVE
# =========================================================

features_df = pd.DataFrame(rows)

SCOUTING_DIR.mkdir(

    parents=True,

    exist_ok=True
)

features_df.to_csv(

    OUTPUT_FILE,

    index=False
)

# =========================================================
# OUTPUT
# =========================================================

print(
    f"\nGenerated "
    f"{len(features_df)} teams."
)

print(
    f"\nSaved:\n"
    f"{OUTPUT_FILE}\n"
)

print(features_df.head())