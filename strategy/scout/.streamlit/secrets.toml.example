# Copy this file to secrets.toml and fill in your key.
# Get a free TBA read key at: https://www.thebluealliance.com/account
# (Account -> Read API Keys -> Add a new key)
#
# Alternatively, export it in your shell instead of using this file:
#   export TBA_AUTH_KEY="your-key-here"

TBA_AUTH_KEY = "your-tba-read-api-key-here"
