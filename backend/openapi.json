{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImportSummaryOut": {
        "properties": {
          "event_key": {
            "title": "Event Key",
            "type": "string"
          },
          "match_teams": {
            "title": "Match Teams",
            "type": "integer"
          },
          "matches": {
            "title": "Matches",
            "type": "integer"
          },
          "season": {
            "title": "Season",
            "type": "integer"
          },
          "teams": {
            "title": "Teams",
            "type": "integer"
          }
        },
        "required": [
          "event_key",
          "season",
          "teams",
          "matches",
          "match_teams"
        ],
        "title": "ImportSummaryOut",
        "type": "object"
      },
      "InviteCreateIn": {
        "properties": {
          "expires_in_hours": {
            "anyOf": [
              {
                "maximum": 8760.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Hours"
          },
          "role": {
            "default": "scout",
            "enum": [
              "scout",
              "strategist",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "title": "InviteCreateIn",
        "type": "object"
      },
      "InviteCreatedOut": {
        "description": "`code` is shown exactly once; only its argon2 hash is stored.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "enum": [
              "scout",
              "strategist",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "role",
          "expires_at"
        ],
        "title": "InviteCreatedOut",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "OkOut": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "OkOut",
        "type": "object"
      },
      "SignupIn": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "invite_code": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Invite Code",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "pattern": "^[A-Za-z0-9_.-]{3,32}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "invite_code",
          "username",
          "password"
        ],
        "title": "SignupIn",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "role": {
            "enum": [
              "scout",
              "strategist",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "active",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FRC Scout AI backend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/import/event/{event_key}": {
      "post": {
        "operationId": "import_event_admin_import_event__event_key__post",
        "parameters": [
          {
            "in": "path",
            "name": "event_key",
            "required": true,
            "schema": {
              "pattern": "^[0-9]{4}[a-z0-9]{2,30}$",
              "title": "Event Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportSummaryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "description": "Unprocessable Content"
          },
          "502": {
            "description": "Bad Gateway"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "summary": "Import Event",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/invites": {
      "post": {
        "operationId": "create_invite_admin_invites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteCreatedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Invite",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/users": {
      "get": {
        "operationId": "list_users_admin_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserOut"
                  },
                  "title": "Response List Users Admin Users Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Users",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/users/{user_id}/deactivate": {
      "post": {
        "operationId": "deactivate_user_admin_users__user_id__deactivate_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "minimum": 1,
              "title": "User Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deactivate User",
        "tags": [
          "admin"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login_auth_login_post",
